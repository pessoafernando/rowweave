<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rowweave</groupId>
        <artifactId>rowweave-parent</artifactId>
        <version>0.2.0</version>
    </parent>

    <!-- ZooKeeper ServiceRegistry implementation as a separate module. Core has no ZooKeeper
         dependency; add this JAR and Curator only for cross-process leader discovery. -->
    <artifactId>rowweave-registry-zk</artifactId>
    <packaging>jar</packaging>
    <name>RowWeave ZooKeeper Registry</name>
    <description>ZooKeeper service registry, master election and ZK-backed authorities, discovered through the core ServiceRegistry SPI.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <!-- Large real-ZK control-plane baselines and separate role JVMs run only through explicit
             profiles so default correctness regression stays fast and resource-isolated. -->
        <rowweave.zk.test.excludedGroups>multiprocess | profile</rowweave.zk.test.excludedGroups>
    </properties>

    <dependencies>
        <!-- Core ServiceRegistry SPI and RegistryWorker. -->
        <dependency>
            <groupId>io.github.rowweave</groupId>
            <artifactId>rowweave-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-recipes</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Curator TestingServer provides an embedded ZooKeeper test dependency. -->
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.rowweave</groupId>
            <artifactId>rowweave-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${rowweave.zk.test.excludedGroups}</excludedGroups>
                    <!-- Curator TestingServer otherwise may bind an IPv6 wildcard while
                         clients resolve localhost to IPv4. A concurrent IPv4 listener can
                         then receive the ZooKeeper handshake and hang the whole reactor. -->
                    <systemPropertyVariables>
                        <java.net.preferIPv4Stack>true</java.net.preferIPv4Stack>
                    </systemPropertyVariables>
                    <!-- Each class creates real TestingServer/Curator sessions.
                         Keep fault-injected session churn and recycled ephemeral
                         ports isolated from subsequent test classes. -->
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>artifact-checksums</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <checksum algorithm="SHA-256" format="MD5SUM">
                                    <fileset dir="${project.build.directory}">
                                        <include name="*.jar"/>
                                        <include name="bom.json"/>
                                        <include name="bom.xml"/>
                                    </fileset>
                                </checksum>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

    </build>

    <profiles>
        <profile>
            <id>cluster-isolated</id>
            <properties>
                <rowweave.zk.test.excludedGroups></rowweave.zk.test.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>multiprocess</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>profile-tests</id>
            <properties>
                <rowweave.zk.test.excludedGroups></rowweave.zk.test.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>profile</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
